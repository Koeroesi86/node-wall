SITE_PROTOCOL=http
SITE_DOMAIN=uzeno.localhost
DB_DRIVER=sqlite3
DB_DATABASE=./lib/data/wall.sqlite
NODEMAILER_HOST=smtp.server.com
NODEMAILER_PORT=465
NODEMAILER_USER=user@server.com
NODEMAILER_PASS=VerySecurePassword
APP_ROOT=
SERVER_PROTOCOL=http
ZOHO_DOMAIN=com
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ACCOUNT_ID=

# Dev only: log the login URL to the console instead of sending the email (set automatically by `npm run dev`; never enable in production; the server refuses to start with it when SITE_PROTOCOL=https)
LOG_LOGIN_CODE=

# Comma separated proxy addresses whose X-Forwarded-For header is trusted for rate limiting (default: 127.0.0.1,::1)
TRUSTED_PROXIES=

# Shown on the privacy notice (/privacy) as the data controller's name and contact email
PRIVACY_CONTROLLER=
PRIVACY_CONTACT_EMAIL=
