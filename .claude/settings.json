{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm test *)",
      "Bash(npm run typecheck)",
      "Bash(npm run build)",
      "Bash(npx vitest *)",
      "Bash(npx tsc *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh run watch *)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./dist/**)",
      "Read(./node_modules/**)",
      "Read(./package-lock.json)",
      "Read(./lib/data/**)"
    ]
  }
}
