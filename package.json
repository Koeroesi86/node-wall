{
  "name": "uzenofal",
  "version": "1.0.0",
  "description": "",
  "main": "serverConfig.js",
  "scripts": {
    "prebuild": "npm run generate:schemas",
    "build": "tsc -p tsconfig.json && tsc -p public/static/tsconfig.json && tsc -p public/tsconfig.service-worker.json && node scripts/copy-assets.mts",
    "pretypecheck": "npm run generate:schemas",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p public/static/tsconfig.json --noEmit && tsc -p public/tsconfig.service-worker.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "clean": "node scripts/clean.mts",
    "knex": "knex",
    "generate:schemas": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generate-schemas.mts",
    "dev": "npm run build && LOG_LOGIN_CODE=true nws-cli --config=./dist/dev.configuration.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@fortawesome/fontawesome-free": "5.15.4",
    "@webcomponents/webcomponentsjs": "2.2.10",
    "cookie": "^0.7.0",
    "dotenv": "^16.0.0",
    "jsdom": "^19.0.0",
    "knex": "^3.3.0",
    "match-all": "^1.2.6",
    "moment": "^2.29.1",
    "nodemailer": "^10.5.0",
    "redux": "4.0.5",
    "sqlite3": "^6.0.1",
    "tributejs": "3.7.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@koeroesi86/node-webserver-cli": "^26.11.42482079849-master",
    "@types/cookie": "^0.4.1",
    "@types/jsdom": "^16.2.15",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@vitest/coverage-v8": "^5.1.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "sqlite3": true
  },
  "engines": {
    "node": ">=24"
  }
}
