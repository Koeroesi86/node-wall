{
  "name": "uzenofal",
  "version": "1.0.0",
  "description": "",
  "main": "serverConfig.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p public/static/tsconfig.json && tsc -p public/tsconfig.service-worker.json && node scripts/copy-assets.mts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p public/static/tsconfig.json --noEmit && tsc -p public/tsconfig.service-worker.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "clean": "node scripts/clean.mts",
    "knex": "knex",
    "dev": "npm run build && nws-cli --config=./dist/dev.configuration.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "cookie": "^0.7.0",
    "dotenv": "^16.0.0",
    "jsdom": "^19.0.0",
    "knex": "^3.3.0",
    "match-all": "^1.2.6",
    "moment": "^2.29.1",
    "nodemailer": "^10.5.0",
    "sqlite3": "^6.0.1",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@koeroesi86/node-webserver-cli": "^26.11.42482079849-master",
    "@types/cookie": "^0.4.1",
    "@types/jsdom": "^16.2.15",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/uuid": "^8.3.4",
    "@vitest/coverage-v8": "^5.1.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "sqlite3": true
  },
  "engines": {
    "node": ">=24"
  }
}
